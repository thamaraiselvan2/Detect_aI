# Public backend URL used in device verification emails.
PUBLIC_API_URL=https://your-backend.onrender.com

# Comma-separated production frontend origins allowed by Flask CORS.
# Local development origins on ports 5173 and 5174 are always allowed.
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-demo-social.vercel.app

# Main frontend build variable. Configure this in Vercel; Flask does not read it.
# Set it to the public backend URL, for example:
# VITE_API_URL=https://your-backend.onrender.com

# SMTP settings for security and alert emails.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=your-gmail-address@gmail.com
MAIL_USE_TLS=true

# Optional AI analysis providers; configure at least one to enable LLM analysis.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
